# GEMINI_API_KEY: Required for Gemini AI API calls (Chef IA, Photo Recognition, Weekly Meal Planner).
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# HOTMART (Webhook oficial de confirmação de assinaturas — X-HOTMART-HOTTOK)
HOTMART_HOTTOK=""
# Opcional: Credenciais da API Hotmart Developers para validação em tempo real de assinaturas
HOTMART_CLIENT_ID=""
HOTMART_CLIENT_SECRET=""
HOTMART_BASIC_TOKEN=""

# STRIPE (Opcional — Pagamentos recorrentes em BRL)
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID_BASIC=""
STRIPE_PRICE_ID_PREMIUM=""
STRIPE_WEBHOOK_SECRET=""

# MERCADO PAGO (Opcional — Alternativa de pagamentos recorrentes no Brasil)
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# ANALYTICS & CONVERSION (Opcional - respeitando consentimento LGPD)
VITE_GA_MEASUREMENT_ID=""
VITE_META_PIXEL_ID=""
